{
  "name": "alltagsteam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-images.mjs && astro dev",
    "build": "node scripts/prepare-images.mjs && astro build",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "preview": "astro preview",
    "check": "node scripts/prepare-images.mjs && astro check",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@fontsource-variable/cormorant-garamond": "^5.0.0",
    "@fontsource-variable/dm-sans": "^5.0.0",
    "astro": "^7.3.1",
    "framer-motion": "^13.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
