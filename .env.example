# Copy to .env.local and configure for your host.
# Public canonical URL (no trailing slash), e.g. https://www.alltagsteam.com
NEXT_PUBLIC_SITE_URL=https://alltagsteam.com

# Server-only SMTP / contact
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=info@alltagsteam.com
# IONOS mailbox password (not your IONOS customer-account password).
SMTP_PASSWORD=
CONTACT_EMAIL=info@alltagsteam.com
