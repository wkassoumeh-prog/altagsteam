# Copy to .env.local and configure for your host.
# Public canonical URL (no trailing slash), e.g. https://www.alltagsteam.com
NEXT_PUBLIC_SITE_URL=https://alltagsteam.com

# Server-only SMTP / contact
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=info@alltagsteam.com
# IONOS mailbox password (not your IONOS customer-account password).
SMTP_PASSWORD=
CONTACT_EMAIL=info@alltagsteam.com

# Admin dashboard (server-only). Add Upstash Redis via Vercel Storage/Marketplace.
# Vercel may inject KV_REST_API_* instead; either naming works in this project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
ADMIN_PASSWORD=
# At least 16 characters; used to sign the admin session cookie.
ADMIN_SESSION_SECRET=
